<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Projects -->
    <record id="view_re_project_tree" model="ir.ui.view">
        <field name="name">re.project.tree</field>
        <field name="model">re.project</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="location"/>
                <field name="unit_count"/>
            </tree>
        </field>
    </record>

    <record id="view_re_project_form" model="ir.ui.view">
        <field name="name">re.project.form</field>
        <field name="model">re.project</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="location"/>
                    </group>
                    <notebook>
                        <page string="Units">
                            <field name="unit_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="unit_type"/>
                                    <field name="area"/>
                                    <field name="price"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Units -->
    <record id="view_re_unit_tree" model="ir.ui.view">
        <field name="name">re.unit.tree</field>
        <field name="model">re.unit</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'available'" decoration-warning="state == 'reserved'" decoration-muted="state == 'sold'">
                <field name="project_id"/>
                <field name="name"/>
                <field name="unit_type"/>
                <field name="floor"/>
                <field name="area"/>
                <field name="price"/>
                <field name="price_per_m2"/>
                <field name="state"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_re_unit_form" model="ir.ui.view">
        <field name="name">re.unit.form</field>
        <field name="model">re.unit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_reserve" type="object" string="Reserve"
                            class="btn-primary" invisible="state != 'available'"/>
                    <button name="action_mark_sold" type="object" string="Mark as Sold"
                            invisible="state == 'sold'"/>
                    <button name="action_release" type="object" string="Release"
                            invisible="state == 'available'"/>
                    <field name="state" widget="statusbar" statusbar_visible="available,reserved,sold"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="name"/>
                            <field name="unit_type"/>
                            <field name="floor"/>
                        </group>
                        <group>
                            <field name="area"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="price"/>
                            <field name="price_per_m2"/>
                            <field name="buyer_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_re_unit_search" model="ir.ui.view">
        <field name="name">re.unit.search</field>
        <field name="model">re.unit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <filter name="available" string="Available" domain="[('state', '=', 'available')]"/>
                <filter name="reserved" string="Reserved" domain="[('state', '=', 'reserved')]"/>
                <filter name="sold" string="Sold" domain="[('state', '=', 'sold')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'unit_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions and menus -->
    <record id="action_re_project" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">re.project</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_re_unit" model="ir.actions.act_window">
        <field name="name">Units</field>
        <field name="res_model">re.unit</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_available': 1}</field>
    </record>

    <menuitem id="menu_re_root" name="Real Estate" sequence="40"/>
    <menuitem id="menu_re_project" name="Projects" parent="menu_re_root" action="action_re_project" sequence="10"/>
    <menuitem id="menu_re_unit" name="Units" parent="menu_re_root" action="action_re_unit" sequence="20"/>
</odoo>
